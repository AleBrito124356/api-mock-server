# api-mock-server needs no secrets. These optional variables set CLI defaults
# so you can run `mockserver serve` (or `python cli.py serve`) without
# repeating flags. Copy this file to .env and edit as needed.
#
# Precedence, highest first: command-line flag > real environment variable >
# this .env file > built-in default. Use `--env-file PATH` to read another file.

# Mocks file for serve / replay / record.
MOCK_CONFIG=examples/shop-api/mocks.yaml

# Bind address for the server.
MOCK_HOST=127.0.0.1
MOCK_PORT=8000

# Seed for deterministic faker data and chaos injection. Any integer.
# Overrides the `seed` inside the mocks file.
MOCK_SEED=7

# For `mockserver record` only: the real upstream to proxy unmatched requests
# to. `mockserver replay` never contacts an upstream.
# MOCK_UPSTREAM=https://api.example.com

# Directory where `record` writes fixtures and `replay` reads them.
MOCK_FIXTURES=fixtures
