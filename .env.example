# api-mock-server needs no secrets. These optional variables just set defaults
# so you can run `python cli.py serve` without repeating flags. Copy this file
# to .env and edit as needed (the CLI flags always win over env values).

# Path to the mocks file to serve.
MOCK_CONFIG=examples/shop-api/mocks.yaml

# Bind address for the server.
MOCK_HOST=127.0.0.1
MOCK_PORT=8000

# Seed for deterministic faker data and chaos injection. Any integer.
MOCK_SEED=7

# For `record` mode only: the real upstream to proxy unmatched requests to.
# Leave blank for pure offline replay from the fixtures directory.
MOCK_UPSTREAM=https://api.example.com

# Directory where recorded fixtures are read from and written to.
MOCK_FIXTURES=fixtures
